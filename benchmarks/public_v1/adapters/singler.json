{
  "method": "singler",
  "reference_policy": "fold_train_only",
  "confidence_semantics": "affine_transform_of_maximum_SingleR_similarity_not_a_probability",
  "argv": [
    "Rscript",
    "{config_dir}/run_singler.R",
    "{train_h5ad}",
    "{test_h5ad}",
    "{output_csv}"
  ],
  "version_command": [
    "Rscript",
    "-e",
    "cat(as.character(packageVersion('SingleR')))"
  ],
  "environment": {
    "R_LIBS_USER": "{config_dir}/../envs/R/library",
    "BASILISK_EXTERNAL_DIR": "{config_dir}/../envs/R/basilisk"
  },
  "timeout_seconds": 7200
}
